# Copy this file to .env and adjust for your environment.
# Never commit .env or real credentials.

# development | production
NODE_ENV=development

# Port the API listens on. FRONTEND's VITE_API_URL must point to it.
PORT=5000

# MongoDB connection string (local MongoDB or MongoDB Atlas). Required.
MONGODB_URI=mongodb://127.0.0.1:27017/girosone

# Frontend origin allowed by CORS, without a trailing slash. Required.
CLIENT_URL=http://localhost:5173

# Admin authentication (used from Phase 6). Use a long random string.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
